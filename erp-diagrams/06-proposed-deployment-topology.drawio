        <mxCell id="e126" value="outbound HTTPS,&lt;br&gt;server-side only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c113" target="c125">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c127" value="&lt;b&gt;Why this shape.&lt;/b&gt; InfinityFree fixes the document root at /htdocs and offers no shell, so the framework is deployed one level above public/ and two rewrite layers bridge the gap. The public disk is a real directory inside the web root because the host cannot create the storage:link symlink; config/filesystems.php reads FILESYSTEM_PUBLIC_ROOT so the application resolves the same tree. Sessions and cache are file-backed and the queue is synchronous because no daemon is available." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="620" y="600" width="520" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
